<header class="navbar navbar-dark primary-background">
  <div class="container-fluid d-flex justify-content-between align-items-center h-100">
    <%= link_to "ナイトレインツール", root_path, class: "navbar-brand" %>
    <% if logged_in? %>
      <div class="d-flex align-items-center gap-3">
        <%= button_to "ログアウト", 
        logout_path, 
        method: :delete,
        class: "btn btn-outline-light header-button-background" %>
        ログイン中
      </div>
    <% else %>
      <%= link_to "ログイン", 
      login_path, 
      class: "btn btn-outline-light header-button-background" %>
    <% end %>
  </div>
</header>
