<h1 class="text-center mb-4">攻略情報を編集</h1>

<div class="card mx-auto" style="max-width: 600px;">
  <div class="card-body">
    <%= form_with model: [@boss, @strategy_post], local: true do |f| %>
      <div class="mb-3">
        <%= f.text_area :body, class: "form-control", rows: 5 %>
      </div>

      <div class="text-end">
        <%= f.submit "更新", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>

<div class="text-center mt-3">
  <%= link_to "一覧へ戻る", boss_strategy_posts_path(@boss) %>
</div>
